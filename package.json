{
  "name": "env-mark",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "EnvMark — 在页面上醒目标记当前站点环境，避免误操作",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "wxt": "^0.21.5"
  }
}
